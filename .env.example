# CreateOS Sandbox (key from https://createos.sh/app/profile or `stripe projects env`)
CREATEOS_SANDBOX_API_KEY=
CREATEOS_API_KEY=
CREATEOS_SANDBOX_BASE_URL=https://api-eu.sb.createos.sh

# LLM (OpenAI directly, or OpenRouter via Stripe Projects: set LLM_BASE_URL=https://openrouter.ai/api/v1)
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1
LLM_BASE_URL=

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_

# Public URL of the orchestrator (for Checkout redirects)
PUBLIC_BASE_URL=http://localhost:8080
